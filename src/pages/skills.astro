---
import BaseLayout, { WIDTH_CLASSES } from '@shared/layouts/BaseLayout.astro';

import Section from '@shared/components/layout/Section.astro'
import RotatingCards, {type Card} from '@shared/components/ui/cards/RotatingCards.astro';
import ProjectsModal from '@/features/projects/components/ModalProjects.astro';
import ProjectLanguages from '@/features/projects/components/ProjectLanguages.astro';


import { Icon } from 'astro-icon/components';
import { I18N } from '@shared/scripts/utils/i18n_keys';
import { getGroupedTechs } from '@shared/data/tech_stack';
import { makeLangStats } from '@shared/data/github_stats';
import { getNavHref } from '@shared/data/links';

import { fade } from 'astro:transitions';


const groups = getGroupedTechs({ 
  categories:[
    'backend', 'languages', 'frontend', 'databases', 'auth',
    'devops', 'tools', 'testing', 'api', 'mobile', 'ai', 'games'
  ] 
});

const mainStack = getGroupedTechs({ 
  categories:[
    'backend', 'languages', 'frontend', 'databases',
    'devops', 'tools', 'testing', 'auth'
  ],
  onlyMain: true 
});

const cardsCarousel: Card[] = mainStack.flatMap((group) =>
  group.techs.map((t) => ({
    icon: t.icon,
    label: t.name,     
    id: t.id ?? '',     
  }))
);

// Languages stats 
const langStats = await makeLangStats(null);

// Define page metadata
const title = "Skills · Callamullo Lucas · Software Engineer";
---

<BaseLayout title={title} mainWidth="full">

  <Section class:list={['bg-surface-900', WIDTH_CLASSES.full]} id='skillsMain' 
    paddingY={false} justifyCenter={false}
  >
    <!-- + MAIN DIV CONTAINER -->
    <div class:list={[
      'flex flex-col w-full', 
      'gap-5 md:gap-6 px-3 md:px-5 py-10', 
      WIDTH_CLASSES.md
    ]}>
      <h1 class="flex gap-3 font_console text-4xl">
        <span class="text-accent">$</span>
        <span class="typewriter-cursor-fast" data-typewriter data-i18n={I18N.skills.title}>ls -la skills/</span>
      </h1>
      <span class="text-content-muted text-lg font_console tracking-wide" data-fade-1 data-i18n={I18N.skills.subtitle}>
        Exploring technical expertise.
      </span>
    </div>
  </Section>


  <!-- + section of MAIN SKILLS -->
  <Section class:list={['bg-surface-800', WIDTH_CLASSES.full]} paddingY={false}>
    <div class:list={['px-2 md:px-1 py-8 w-full h-min', WIDTH_CLASSES.md]}>

      <div class="flex flex-col items-center justify-center gap-5 cont_animate__from_left_lg"
        data-reveal data-multi-anim
      >
        <h2 class="font_console text-3xl flex items-center gap-2 tracking-wider">
          <span class="text-accent">$</span>
          <span class="text-content-muted">cat</span>
          <span class="text-console font-bold">'Main-Stack'</span>
        </h2>
        <span class="text-lg font_console tracking-wide text-content-muted"
          data-i18n={I18N.skills.main.subtitle}
        >
          Where I have the most hands-on experience.
        </span>
      </div>
      
      <!-- STACK MAIN CARDS -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4.5 mt-7" id="contStackMain">
        {mainStack.map((group) => (
          <div class="flex flex-col rounded-xl bg-surface-200
            cont_border_effect cont_btns_3d cont_animate__from_left_lg"
            data-reveal
          >
            <h3 class="font_console text-lg text-accent uppercase tracking-wider
              bg-surface-200 px-3.5 py-2.5">
              <span data-i18n={group.category.i18n}>{group.category.label}</span>
            </h3>

            <div class="flex flex-wrap flex-1 bg-surface-900 px-2 py-3.5 gap-2">
              {group.techs.map((tech) => (
                <button class="flex items-center gap-2 w-min h-min px-2 py-1.5 cursor-pointer rounded-2xl z-30
                  cont_btns_3d__btn_effect border border-console-400 btn__glass_effect"
                  data-tech={tech.id} type="button" title="View Projects"
                  data-i18n={tech.name} data-title="Projects"
                >
                  <Icon
                    name={tech.icon}
                    class={`w-6 h-6 ${tech.isOnlyLightTheme ? 'bg-white rounded-md p-0.5' : ''}`}
                  />
                  <span class="font_console text-sm text-content-main truncate">
                    {tech.name} 
                  </span>
                </button>
              ))}
            </div>

            {/* <!-- Effects absolute --> */}
            <span class="cont_border__anim_effect border-console rounded-xl border-2"></span>
          </div>
        ))}
      </div>

      <!-- STATS AND BTN GH -->
      <div class="mt-5 flex w-full gap-5 items-center justify-center h-min">

        <!-- 
        <img src={topLangsUrl} alt="GitHub Top languages" loading="lazy" 
          class="w-full md:w-[40%] h-full self-center place-self-center">  -->

        <div id="donutSkills">
          {/* <!-- Donut (por defecto) kind="donut" --> */}
          {langStats && langStats.length > 0 && (
            <ProjectLanguages langs={langStats} 
              title="Stack breakdown · Featured projects" 
              data_i18n="" 
            >

              <div class="flex justify-between items-start">
                <a class="font_console rounded-3xl btn_w_tag cursor-pointer
                  border group hover-up border-console-400" 
                  href={getNavHref('github')} target="_blank"
                  title="Go GitHub!"
                >
                  <span class="btn_w_tag__top py-1 rounded-3xl flex items-center text-white
                    justify-center bg-console-400 text-sm truncate w-full! ml-0!" data-i18n=''>
                    See GitHub!
                  </span>
                  
                  <div class="flex gap-2 items-center justify-center text-content-main py-1 px-1.5 
                    btn_move__cont_svg group-hover:btn_move__cont_svg:hover group-hover:bg-green-800 rounded-3xl"
                  >
                    <Icon name="ri:github-fill" class="h-5 w-5 btn_move__svg_svg group-hover:text-white"></Icon>
                    <span class="truncate text-sm group-hover:text-white" 
                      data-i18n={I18N.links.other_github}>Go GitHub</span>
                  </div>
                </a>

                <button title="View selected projects"
                  class="cursor-pointer text-sm text-content-muted hover:text-accent self-end 
                    flex gap-1.5 items-center"
                  data-tech="REPOS_TO_DONUT"
                  title="View Projects" data-title="I18N" data-i18n={I18N.projectsPage.donutSkillsSubtitle}
                >
                  <Icon name="ri:stack-line" class="h-5 w-5"></Icon>
                  <span data-i18n={I18N.projectsPage.donutSkillsSubtitle}>Ver proyectos seleccionados</span>
                </button>
              </div>
            </ProjectLanguages>
          )}


        </div>
      </div>

    </div>
  </Section>

  <!-- + SECTION ---- STACK CAROUSEL MAIN CARDS -->
  <Section class:list={['bg-surface-900', WIDTH_CLASSES.full]} paddingY={false} paddingX={false}>
    <div class:list={[
      'w-full flex flex-col gap-8 py-10', 
      WIDTH_CLASSES.md
    ]}>

      <div class="flex flex-col items-center justify-center gap-5 cont_animate__from_left_lg px-2 md:px-4"
        data-reveal data-multi-anim
      >
        <h2 class="font_console text-3xl flex flex-wrap text-center justify-center items-center gap-2 tracking-wider">
          <span class="text-accent">$</span>
          <span class="text-content-muted">cat</span>
          <span class="text-console font-bold" data-i18n={I18N.skills.carousel.title}>
            'My Main Stack Carousel'
          </span>
        </h2>
        <span class="text-base font_console tracking-wide text-content-muted"
          data-i18n={I18N.skills.carousel.subtitle}
        >
          The technologies I use daily, on rotation.
        </span>
      </div>

      <div class:list={["h-55 w-full px-2 md:px-4", WIDTH_CLASSES.md]}>
        <RotatingCards cards={cardsCarousel} id='carouselStack' />
      </div>
    
    </div>  
  </Section>


  <!-- + Sección of RESUME  SKILLS -->
  <Section class:list={['bg-surface-800', WIDTH_CLASSES.full]}>
    <div class:list={['px-2 md:px-4 py-6 w-full', WIDTH_CLASSES.md]}>

      <div class="flex flex-col gap-3 items-center justify-center p-2 mb-4 md:mb-5 cont_animate__from_left_lg"
        data-reveal data-multi-anim
      >
        <h2 class="font_console text-3xl flex flex-wrap items-center justify-center text-center gap-2 tracking-wider">
          <span class="text-accent">$&nbsp;</span>
          <span class="text-content-muted">ls -la&nbsp;</span>
          <span class="text-console font-bold" data-i18n={I18N.skills.all.title}>
            all-techs/
          </span>
        </h2> 
        <span data-i18n={I18N.skills.all.subtitle}
          class="font_console text-content-muted text-lg font-md tracking-wide" > 
          Everything I've used across projects.
        </span>
      </div>

      <div class="grid md:grid-cols-2 gap-6 relative" id="contAllStack">
        {groups.map((group, index) => (
          <section data-reveal
            class:list={[
              'border rounded-2xl border-emerald-500 h-full flex flex-col relative cont_btns_3d',
              index % 2 === 0 ? 'timeline_animate__from_left' : 'timeline_animate__from_right',
            ]}
          >
            <div class="bg-surface-200 rounded-t-2xl flex justify-between items-center px-4 py-3">
              <h3 data-i18n={group.category.i18n} class="font_console text-console tracking-wider font-xl">
                {group.category.label}
              </h3>
              <div class="flex gap-2">
                <span class="rounded-full bg-red-500 h-3 w-3 border border-surface-900"></span>
                <span class="rounded-full bg-yellow-500 h-3 w-3 border border-surface-900"></span>
                <span class="rounded-full bg-green-500 h-3 w-3 border border-surface-900"></span>
              </div>
            </div>

            {/* <!-- grid md:grid-cols-3 --> */}
            <div class="bg-surface-900 rounded-b-2xl flex-wrap flex w-full flex-1 justify-start items-start
              gap-2.5 px-4 py-4 overflow-auto relative ">
                {group.techs.map((tech) => (
                  <button class="flex items-center gap-2 px-3.5 py-2 cont__border_animate w-min 
                    cont_btns_3d__btn_effect cursor-pointer"
                    data-tech={tech.id} type="button" title="View Projects"
                    data-i18n={tech.name} data-title="Projects"
                  >
                    <Icon
                      name={tech.icon}
                      class={`h-5 w-5 ${tech.isOnlyLightTheme ? 'bg-white rounded-2xl p-0.5' : ''}`}
                    />
                    <span class="font_console text-base truncate">{tech.name}</span>
                  </button>
                ))}
            </div>
          </section>
        ))}
      </div> 


    </div>  
  </Section>


  <!-- + MODAL PROJECTS COMPONENTS -->
  <ProjectsModal modalId="modalProjects" overlayId="overlayProjects"/>

  <script>
    import { initSetupSkills } from "@/features/skills/scripts/init";
    document.addEventListener('astro:page-load', initSetupSkills);
  </script>
</BaseLayout>
