---
import BaseLayout from '@layouts/BaseLayout.astro';

// Define page metadata
const title = "Callamullo Lucas · Software Engineer";
---

<BaseLayout title={title}>
  <main class="max-w-4xl mx-auto py-10 px-4">
    <h1 class="text-4xl font-bold mb-6">Hello, testing Astro for the first time!</h1>

    <div class="bg-primary-bg text-primary-text border border-border-cont p-6 rounded-lg">
      <h2 class="text-main font-bold text-2xl">Project Title</h2>
      <p class="text-secondary-text mt-2">Description text using secondary text color.</p>
      
      <!-- Added id="theme-toggle" to reference the button in JS -->
      <button 
        id="theme-toggle" 
        class="bg-main text-white px-4 py-2 rounded hover:bg-main-light transition-colors mt-4 cursor-pointer"
      >
        Switch Theme
      </button>
    </div>
  </main>
</BaseLayout>

<script>
  // This script runs entirely in the browser (client-side)
  const toggleBtn = document.getElementById('theme-toggle');
  
  // Available themes defined in your global.css
  const themes = ['light', 'dark', 'violet', 'blue'];
  let currentThemeIndex = 0;

  toggleBtn?.addEventListener('click', () => {
    // Cycle to the next theme in the array
    currentThemeIndex = (currentThemeIndex + 1) % themes.length;
    const nextTheme = themes[currentThemeIndex];

    // Update the data-theme attribute on the <html> tag
    document.documentElement.setAttribute('data-theme', nextTheme);
    
    // Update button text to reflect current active theme
    toggleBtn.textContent = `Current Theme: ${nextTheme.toUpperCase()}`;
  });
</script>