---
import BaseLayout from '@layouts/BaseLayout.astro';

// Define page metadata
const title = "Callamullo Lucas · Software Engineer";
---

<BaseLayout title={title}>

    <h1 class="text-4xl font-bold mb-6">Hello, testing Astro for the first time!</h1>

    <!-- ==============================================
        1. COLORES DE MARCA (main-300 / 500 / 700)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">1. Main (brand)</h2>
      <div class="flex flex-wrap gap-3">
        <div class="px-4 py-2 rounded-lg bg-main-300 text-content-main">bg-main-300</div>
        <div class="px-4 py-2 rounded-lg bg-main-500 text-white">bg-main-500</div>
        <div class="px-4 py-2 rounded-lg bg-main-700 text-white">bg-main-700</div>
      </div>
      <div class="flex flex-wrap gap-3 mt-3">
        <span class="text-main-300 font-semibold">text-main-300</span>
        <span class="text-main-500 font-semibold">text-main-500</span>
        <span class="text-main-700 font-semibold">text-main-700</span>
      </div>
    </section>

    <!-- ==============================================
        2. SURFACES (100 / 200 / 800 / 900)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">2. Surfaces</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="h-20 rounded-lg bg-surface-100 border border-surface-800 flex items-center justify-center text-content-main text-sm">
          surface-100
        </div>
        <div class="h-20 rounded-lg bg-surface-200 border border-surface-800 flex items-center justify-center text-content-main text-sm">
          surface-200
        </div>
        <div class="h-20 rounded-lg bg-surface-800 border border-surface-100 flex items-center justify-center text-content-main text-sm">
          surface-800
        </div>
        <div class="h-20 rounded-lg bg-surface-900 border border-surface-100 flex items-center justify-center text-content-main text-sm">
          surface-900
        </div>
      </div>
    </section>

    <!-- ==============================================
        3. TEXTO (content-main / content-muted)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">3. Contenido</h2>
      <p class="text-content-main text-lg">Este es <strong>content-main</strong> — texto principal.</p>
      <p class="text-content-muted text-lg">Este es <strong>content-muted</strong> — texto secundario.</p>
    </section>

    <!-- ==============================================
        4. COLORES CUSTOM (console / accent)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">4. Custom (console + accent)</h2>
      <div class="flex flex-wrap gap-3">
        <div class="px-4 py-2 rounded-lg bg-console text-surface-900 font-mono font-bold">
          bg-console
        </div>
        <div class="px-4 py-2 rounded-lg bg-accent text-surface-900 font-mono font-bold">
          bg-accent
        </div>
        <span class="text-console font-mono font-bold">text-console</span>
        <span class="text-accent font-mono font-bold">text-accent</span>
      </div>
    </section>

    <!-- ==============================================
        5. BRAND FIXED COLORS (red / green / wsp)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">5. Brand fixed</h2>
      <div class="flex flex-wrap gap-3">
        <div class="px-4 py-2 rounded-lg bg-brand-red text-white">brand-red</div>
        <div class="px-4 py-2 rounded-lg bg-brand-green text-white">brand-green</div>
        <div class="px-4 py-2 rounded-lg bg-brand-wsp text-white">brand-wsp</div>
      </div>
    </section>

    <!-- ==============================================
        6. COMBINACIONES / BORDES / HOVER
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">6. Bordes + hover</h2>
      <div class="flex flex-wrap gap-3">
        <div class="px-4 py-2 rounded-lg bg-surface-200 border border-surface-800 text-content-main
                    hover:bg-main-500 hover:text-white hover:border-main-700 transition-colors cursor-pointer">
          hover me
        </div>
        <div class="px-4 py-2 rounded-lg border-2 border-main-500 text-main-500
                    hover:bg-main-500 hover:text-white transition-colors cursor-pointer">
          outlined main
        </div>
        <div class="px-4 py-2 rounded-lg bg-console text-surface-900 font-mono
                    hover:bg-accent transition-colors cursor-pointer">
          console → accent
        </div>
      </div>
    </section>

    <!-- ==============================================
        7. SIMULACIÓN DE CONSOLA (usa --console-color)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">7. Consola</h2>
      <div class="bg-surface-900 border border-surface-800 rounded-lg p-4 font-mono text-sm">
        <p class="text-content-muted">$ <span class="text-content-main">echo "theme test"</span></p>
        <p class="text-console">theme test<span class="blinking_underscore">_</span></p>
        <p class="text-accent">warning: colors loaded ✓</p>
      </div>
    </section>

    <!-- ==============================================
        8. TABLA COMPARATIVA DE TEMAS
        (cambia el data-theme en la navbar y mira esta sección)
        ============================================== -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">8. Resumen</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border border-surface-800 rounded-lg overflow-hidden">
          <thead class="bg-surface-200 text-content-muted">
            <tr>
              <th class="text-left px-3 py-2">Token</th>
              <th class="text-left px-3 py-2">Muestra</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-800">
            <tr><td class="px-3 py-2 font-mono">main-500</td><td class="px-3 py-2"><span class="inline-block w-6 h-6 rounded bg-main-500"></span></td></tr>
            <tr><td class="px-3 py-2 font-mono">surface-200</td><td class="px-3 py-2"><span class="inline-block w-6 h-6 rounded bg-surface-200 border border-surface-800"></span></td></tr>
            <tr><td class="px-3 py-2 font-mono">surface-900</td><td class="px-3 py-2"><span class="inline-block w-6 h-6 rounded bg-surface-900 border border-surface-800"></span></td></tr>
            <tr><td class="px-3 py-2 font-mono">console</td><td class="px-3 py-2"><span class="inline-block w-6 h-6 rounded bg-console"></span></td></tr>
            <tr><td class="px-3 py-2 font-mono">accent</td><td class="px-3 py-2"><span class="inline-block w-6 h-6 rounded bg-accent"></span></td></tr>
          </tbody>
        </table>
      </div>
    </section>

</BaseLayout>