---
import BaseLayout, { WIDTH_CLASSES } from '@layouts/BaseLayout.astro';
import Section from '@shared/components/Section.astro'
import CardSection from '@shared/components/CardSection.astro'

import { Icon } from 'astro-icon/components';
import { I18N } from '@shared/scripts/utils/i18n_keys';
import { getGroupedTechs } from '@shared/data/tech_stack';
import { getSocialLinks, getNavItem } from '@shared/data/links';


const links = getSocialLinks(['linkedin', 'github', 'email', 'cv_contact']);

// Define page metadata
const title = "Callamullo Lucas · Software Engineer";
---

<BaseLayout title={title} mainWidth="full">

   <Section class:list={['bg-surface-900', WIDTH_CLASSES.full]} id='contactMain' 
    paddingY={false} justifyCenter={false}
  >
    <!-- + MAIN DIV CONTAINER -->
    <div class:list={[
      'flex flex-col w-full', 
      'gap-5 md:gap-6 px-3 md:px-5 py-10', 
      WIDTH_CLASSES.md
    ]}>
      <h1 class="flex gap-3 font_console text-4xl">
        <span class="text-accent">$</span>
        <span class="typewriter-cursor-fast" data-typewriter data-i18n={I18N.contact.title}>ping contact.server</span>
      </h1>
      <span class="text-content-muted text-lg font_console tracking-wide" data-fade-1 data-i18n={I18N.contact.subtitle}>
        Establishing connection to communication endpoint.
      </span>
    </div>
  </Section>



  <!-- + Sección of RESUME FORM & BTNS -->
  <Section class:list={['bg-surface-800', WIDTH_CLASSES.full]} paddingY={false}>
    <div class:list={[
      'px-2 md:px-4 py-10 gap-6 md:gap-8 grid md:grid-cols-3 w-full', 
      WIDTH_CLASSES.md
    ]}>

      <CardSection hover={false} bordered={true} data-reveal
        class="bg-surface-200 max-w-3xl md:col-span-2 cont_animate__from_left_lg
          justify-start items-start h-min" 
      >

        <form action="" class="font_console grid md:grid-cols-2 gap-5 w-full min-w-full" id="contactForm">

          <h2 class="text-2xl gap-2 flex cont_animate__from_left_lg md:col-span-2 tracking-wider" data-reveal>
            <span class="text-accent">$</span>
            <span class="text-content-muted">echo</span>
            <span class="text-console font-bold" data-i18n={I18N.contact.form.title}>'Contact Me'</span>
          </h2>

          <label class="flex flex-col gap-2 mt-2 md:mt-2 tracking-wide text-lg">
            <span class="" data-i18n={I18N.contact.form.name}>Name:</span>
            <input type="text" name="name" class="border bg-surface-900 h-10 px-2 py-1" required>
          </label>

          <label class="flex flex-col gap-2 mt-2 md:mt-2 tracking-wide text-lg">
            <span class="" data-i18n={I18N.contact.form.email}>Email:</span>
            <input type="email" name="email" class="border bg-surface-900 h-10 px-2 py-1" required>
          </label>

          <label class="flex flex-col gap-2 md:col-span-2 tracking-wide text-lg">
            <span class="" data-i18n={I18N.contact.form.message}>Message:</span>
            <textarea name="message" class="border bg-surface-900 h-33 px-2 py-1" required></textarea>
          </label>
          
          <!-- SUBMIT -->
          <button class="self-center place-self-center flex items-center justify-center md:col-span-2
            btn_move__cont_svg rounded-full cursor-pointer mt-4 gap-2 h-11 px-3 py-3 group hover-up
            bg-main-500 border-2 border-main-700"
            type="submit"
          >
            <span class="absolute h-11 w-11 left-0 flex justify-center items-center rounded-full 
              group-hover:bg-main-300">
              <Icon name="ri:send-plane-line" 
                class="h-5 w-5 btn_move__svg_svg group-hover:text-console">
              </Icon>
            </span>

            <span class="text-white font-bold pl-11 pr-5 text-lg tracking-wider group-hover:text-console"
              data-i18n={I18N.contact.form.btn} id="spanSubmit"
            >
              Send
            </span>
          </button>
        </form>

      </CardSection>

      <!-- + STATS FORM EXTRA INFO ---> 
      <CardSection class="bg-surface-200 max-w-3xl h-min gap-3 p-2 md:p-3.5 cont_animate__from_left_lg" 
        data-reveal hover={false} bordered={true} paddingDef={false}>

        <h2 class="font_console text-xl">
          <span class="text-accent">$&nbsp;</span>
          <span class="text-content-muted">cat&nbsp;</span>
          <span class="text-console font-bold tracking-wider" data-i18n={I18N.contact.extra.title}>'Availability Status'</span>
        </h2>


        <p class="pt-3 flex items-center gap-3 font_console">
          <span class="inline-block w-3 h-3 rounded-full bg-brand-green-100 shadow-brand-green-100 animate-pulse"></span>
          <span class="text-base tracking-wide" data-i18n={I18N.contact.extra.subtitle}>
            Open to opportunities
          </span>
        </p>

        <span class="font_console text-content-muted tracking-wide" data-i18n={I18N.contact.extra.span1}>
          Response time: Within 24 hours
        </span>

        <div class="flex items-center gap-2 font_console">
          <Icon name="ri:time-zone-line" class="h-5 w-5"></Icon>
          <span class="text-content-muted text-sm" data-i18n={I18N.contact.extra.span2}>ART (UTC-3)</span>  
        </div>

        <div class="flex items-center gap-2 font_console">
          <Icon name="ri:map-pin-line" class="h-5 w-5"></Icon>
          <span class="text-content-muted text-sm">Córdoba, Argentina</span>  
          <img class="w-5 h-4 rounded-sm object-cover" src="/icons/flag_ar.svg" />
        </div>

        <h3 class="font_console text-lg mt-6">
          <span class="text-accent">$&nbsp;</span>
          <span class="text-content-muted">cat&nbsp;</span>
          <span class="text-console font-bold tracking-wider" data-i18n={I18N.contact.extra.title2}>'Connect with me'</span>
        </h3>

        <div class="gap-x-6 gap-y-5 md:gap-y-8 grid md:grid-cols-2 font_console w-full mt-2">
          {links.map((link) => (
            <a href={link.href} target={link.newTab ? '_blank' : undefined}
              class="w-full rounded-full btn_w_tag bg-content-main border group hover-up"
              data-cv={link.altText == 'LucasCallamullo_Software_Resume.pdf' ? 'true' : undefined}
              data-i18n={link.altText == 'LucasCallamullo_Software_Resume.pdf' ? link.href : undefined}
              download={link.altText == 'LucasCallamullo_Software_Resume.pdf' ? link.altText : undefined}
            >
              <span class="btn_w_tag__top py-1.5 px-2 rounded-full flex items-center justify-center 
                bg-main-300 text-base">
                <span data-i18n={link.i18n_other}>Go GitHub</span>
              </span>

              <div class="flex gap-2 items-center justify-center text-surface-200 py-1.5 px-2 
                btn_move__cont_svg">
                <Icon name={link.icon} class="h-5 w-5 btn_move__svg_svg"></Icon>
                <span class="truncate text-base " data-i18n={link.i18n}>{link.altText}</span>
              </div>
            </a>
          ))}

          <button class="w-full rounded-3xl btn_w_tag bg-content-main border cursor-pointer group hover-up" 
            id="copyEmailBtn"
          >
            <span class="btn_w_tag__top py-1.5 px-2 rounded-3xl flex items-center justify-center bg-main-300 text-base">
              <span data-i18n={I18N.contact.extra.copy_email} id="copyEmailBtnTag">
                Copy Email
              </span>
              <span>!</span>
            </span>
            
            <div class="flex gap-2 items-center justify-center text-surface-200 py-1.5 px-2 
              btn_move__cont_svg group-hover:btn_move__cont_svg:hover"
            >
              <Icon name="ri:file-copy-2-line" class="h-5 w-5 btn_move__svg_svg"></Icon>
              <span class="truncate text-base" data-i18n={I18N.contact.extra.copy_email}>Copy Email</span>
            </div>
          </button>
        </div>

      </CardSection>

    </div>
  </Section>



  <!--  + Span de enviado email -->
  <Section class:list={['bg-surface-200', WIDTH_CLASSES.full]} paddingY={false}>
    <div class:list={[
      'px-2 md:px-20 py-18 gap-6 md:gap-8 w-full bg-surface-200 h-60 md:h-51', 
      WIDTH_CLASSES.md
    ]}>

      <div class="hidden flex-col gap-20 justify-center align-center h-full max-w-full" id="contSuccesForm">
        <p class="font_console text-center flex flex-col gap-2 tracking-wider" id="successMsg"></p>
        <div class="loader_snake place-self-center self-center">
          <span class="dot_snake"></span>
          <span class="dot_snake"></span>
          <span class="dot_snake"></span>
          <span class="dot_snake"></span>
          <span class="dot_snake"></span>
        </div>
      </div> 

    </div>
  </Section>



  <!-- + Sección of CONTACT END -->
  <Section class:list={['bg-surface-900', WIDTH_CLASSES.full]} paddingY={false}>
    <div class:list={[
      'px-2 md:px-20 py-18 gap-6 md:gap-8 w-full', 
      WIDTH_CLASSES.md
    ]}>

      <div class:list={[
        'bg-surface-200 relative flex items-center justify-center h-70 md:h-60 rounded-3xl group',
        'border-2 border-transparent w-full',
        WIDTH_CLASSES.sm
      ]}>

        <div class="flex flex-col items-center justify-center 
          z-20 hover-up-5xl h-full w-full rounded-3xl p-6 
          bg-surface-800 group-hover:border-console border-2 border-transparent"
        >
          <h2 class="font_console text-2xl
            flex flex-wrap items-center justify-center text-center wrap-break-word">
            <span class="text-accent" data-i18n>$&nbsp;</span>
            <span class="text-content-muted">echo&nbsp;</span>
            <span class="text-console" data-i18n={I18N.contact.end.title}>
              "Thanks for stopping by"
            </span>
          </h2>

          <span class="text-content-muted text-lg mt-6 text-center wrap-break-word" data-i18n={I18N.contact.end.span1}> 
            If you want to chat, my emails are always open!
          </span>

          <span class="text-content-muted text-lg mt-3 text-center wrap-break-word" data-i18n={I18N.contact.end.span2}>
            I'll answer faster if you contact via email.
          </span>
        </div>

        <!--  BOTTOM  CONTAINER  -->
        <div class="absolute left-0 top-0 px-3 z-10 bg-surface-200 rounded-3xl p-6 h-full w-full">
          <div class="relative h-full w-full rounded-3xl pt-12 flex text-center justify-center items-end">
            <span class="text-console wrap-break-word" data-i18n={I18N.contact.end.span3}>
              Connection established. Awaiting your message... :D
            </span>
          </div>
        </div>

      </div>


    </div>
  </Section>

  <script>
    import { setEventTypewriter } from '@shared/scripts/utils/typewriter';
    import { setupClipboardCopy } from '@/contact/scripts/copy_email';
    import { initContactForm } from '@/contact/scripts/form_contact';

    async function boot() {
      // this events call init typewriter methods, only need the right selectors
      setEventTypewriter({
        container: '#contactMain',
        title: '[data-typewriter]',
        elementsToFade: ['[data-fade-1]'],
      });

      setupClipboardCopy('#copyEmailBtn', '#copyEmailBtnTag');

      initContactForm('#contactForm', '#contSuccesForm');
    }

    document.addEventListener('astro:page-load', boot);
  </script>
</BaseLayout>