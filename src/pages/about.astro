---
import BaseLayout, { WIDTH_CLASSES } from '@layouts/BaseLayout.astro';
import Section from '@shared/components/Section.astro'
import CardSection from '@shared/components/CardSection.astro'

import { Icon } from 'astro-icon/components';
import { I18N } from '@shared/scripts/utils/i18n_keys';

import { getProjects, formatDateRange } from '@shared/data/projects';
import { getTechs } from '@shared/data/tech_stack';
import { getNavHref } from '@shared/data/links';

// recupero stack list para completar
const frontend = getTechs(['typescript', 'react', 'tailwind', 'javascript']);
const backend = getTechs(['java', 'springboot', 'csharp', 'dotnet']);
const databases = getTechs(['postgresql', 'redis']);
const devops = getTechs(['dockerCompose', 'nginx', 'linux', 'bash']);
const mainTechs = getTechs(['java', 'springboot', 'junit', 'typescript', 'react', 'postgresql', 'docker', 'nginx']);

interface TechRow {
  label: string;
  items: ReturnType<typeof getTechs>;
}

const techRows: TechRow[] = [
  { label: 'Frontend:', items: frontend },
  { label: 'Backend:',  items: backend },
  { label: 'DB:',       items: databases },
  { label: 'DevOps:',   items: devops },
];

// Ordenar los proyectos por fecha, ascendente.
const timelineProjects = getProjects({ hasTimeline: true, sortBy: 'timeline', orderBy: 'asc' });
const milestones = getProjects({ hasTimeline: true, sortBy: 'timeline', orderBy: 'desc' });

// Define page metadata
const title = "About · Callamullo Lucas · Software Engineer";
---

<BaseLayout title={title} mainWidth="full">

  <Section class:list={['bg-surface-900', WIDTH_CLASSES.full]} id='aboutMain'>
    <!-- + MAIN DIV CONTAINER -->
    <div class="flex flex-col justify-center items-start w-full h-34 max-w-full md:max-w-6xl gap-4">
      
      <h1 class="flex gap-3 font_console text-4xl">
        <span class="text-accent">$</span>
        <span class="typewriter-cursor-fast" data-typewriter 
          data-i18n={I18N.about.title}>cat about.txt</span>
      </h1>
      <span class="text-content-muted text-lg" data-fade-1 data-i18n={I18N.about.subtitle}>
        Displaying professional background.
      </span>
    </div>
  </Section>


  <!-- + Sección of RESUME BIO -->
  <Section class:list={['bg-surface-800', WIDTH_CLASSES.full]}>

    <div class="max-w-full md:max-w-6xl py-5 gap-3 grid grid-cols-1 md:grid-cols-3">
    
      <CardSection class="bg-surface-900 max-w-3xl col-span-2 gap-3 cont_animate__from_left_lg" 
        hover={false} bordered={true} data-reveal>

        <h2 class="font_console text-2xl flex gap-2 border-b-2 pb-3 w-full border-content-muted">
          <span class="text-accent">$</span>
          <span class="text-console">cat</span>
          <span>bio.txt</span>
        </h2>

        <p class="font_console text-base text-justify cont_animate__from_left" data-i18n={I18N.about.bio.p1} data-reveal>
          Hi! I'm Lucas Callamullo, a Backend / Full stack developer based in Córdoba, Argentina.
        </p>

        <p class="font_console text-base text-justify cont_animate__from_left" data-i18n={I18N.about.bio.p2} data-reveal>
          I've been fascinated by programming logic ever since I started modifying game mods. 
          I probably spend more time than I should coding some idea.
        </p>
        <p class="font_console text-base text-justify cont_animate__from_left" data-i18n={I18N.about.bio.p3} data-reveal>
          Over the last 3 years, I built my own RoadMap — a self-taught Full-Stack journey focused on building real-world 
          applications from scratch. Alongside that, I'm currently in my fourth year of Systems Engineering at UTN.
        </p>
        <p class="font_console text-base text-justify cont_animate__from_left" data-i18n={I18N.about.bio.p4} data-reveal>
          Teaching was one of the experiences I enjoyed the most. What I loved about this RoadMap was teaching programming 
          (Algorithms and Paradigms) for university courses over 2 years. It taught me how to break down complex ideas into 
          plain language and introduced me to amazing people who are now friends.
        </p>

        <p class="font_console text-base text-justify cont_animate__from_left" data-reveal> 
          <span data-i18n={I18N.about.bio.p5}>My technical experience covers</span>
          <b class="text-console bolder tracking-wider">&nbsp;e2e</b>
          &nbsp;(<b class="text-main-500 tracking-wider">EndToEnd</b>) Apps: 
        </p>

        <!-- + RENDER GENERICS TECHS -->
        {techRows.map(({ label, items }) => (
          <p class="font_console text-base flex items-center justify-center ms-1 md:ms-6 flex-wrap cont_animate__from_left" 
            data-reveal data-multi-anim>
            <strong class="text-accent">{label}</strong>
            {items.map((t, index) => (
              <>
                <Icon name={t.icon} class="ms-3" />
                <span class="ms-2 truncate">{t.name}</span>
                {index < items.length - 1 && <span class="ms-2 text-console">|</span>}
              </>
            ))}
          </p>
        ))}

        <p class="font_console text-base text-justify mt-2 cont_animate__from_left" data-i18n={I18N.about.bio.p6} data-reveal>
          To me, programming is about simplifying life through code — even if replicating life's randomness seems impossible. 
          I love that code is our medium to turn any idea into reality.
        </p>
      </CardSection>

      <!-- + QUICK STATS SECTION ---> 
      <CardSection class="bg-surface-900 max-w-3xl h-min gap-3 p-2 md:p-4 cont_animate__from_left" data-reveal
        hover={false} bordered={true} paddingDef={false}>

        <h3 class="flex gap-1 items-center justify-start font_console text-xl cont_animate__from_left" data-reveal>
          <span class="text-accent">$</span>
          <span class="text-console">cat</span>
          <span data-i18n={I18N.about.stats.title}>stats.txt</span>
        </h3>

        <div class="grid grid-cols-[auto_1fr] w-full font_console text-base md:text-lg gap-x-2 gap-y-1.5">

          <span class="text-content-muted cont_animate__from_left" data-i18n={I18N.about.stats.projectLabel} data-reveal>
            Projects:</span>
          <span class="text-right text-console cont_animate__from_left" data-i18n={I18N.about.stats.projectTotal} data-reveal>
            4+ Completed</span>

          <span class="text-content-muted cont_animate__from_left" data-i18n={I18N.about.stats.currentLabel} data-reveal>
            Currently:</span>
          <span class="text-right text-console cont_animate__from_left" data-i18n={I18N.about.stats.currentTotal} data-reveal>
            Systems Eng. — 4th year</span>

          <span class="text-content-muted cont_animate__from_left" data-i18n={I18N.about.stats.universityLabel} data-reveal>
            University:</span>
          <a class="text-right hover:text-main-500 w-min truncate place-self-end cont_animate__from_left" 
            href={getNavHref('utn')} target="_blank" data-reveal> 
            UTN · FRC</a>

          <span class="text-content-muted cont_animate__from_left" data-i18n={I18N.about.stats.residenceLabel} data-reveal>
            Location:</span>
          <span class="text-right cont_animate__from_left" data-reveal>
            Córdoba, Argentina</span>

          <strong class="mt-3 col-span-2 flex flex-wrap w-full gap-1 items-center text-content-muted" data-reveal> 
            Main Stack:
          </strong>

          <ul class="w-full col-span-2 gap-2 grid grid-cols-2">
            {mainTechs.map((t, index) => (
              <li
                class:list={[
                  'flex flex-wrap items-center gap-2 cont_animate__from_left',
                  // Si es impar (segundo, cuarto, etc.), alinearlo a la derecha.
                  index % 2 === 1 && 'place-self-end',
                ]}
                data-reveal data-multi-anim
              >
                <Icon name={t.icon} />
                <span class="truncate text-accent">{t.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </CardSection>

    </div>

    <!-- + TIMELINE --> 
    <div class="flex flex-col align-center justify-center text-center gap-3 cont_animate__from_left" data-reveal data-multi-anim>
      <h2 class="text-console text-3xl font_console font-bold" data-i18n="about.timeline">
        Career Timeline
      </h2>
      <span class="text-lg text-content-muted font_console" data-i18n="about.sub_timeline">
        From university assignments to robust systems with professional architecture
      </span>
    </div>

    <ul class="timeline_cont_line w-full mt-4" id="classicTimeline"> 
      {timelineProjects.map((p, index) => (
        <li class="timeline_cont__item">
          <div data-reveal data-multi-anim
            class:list={[
              'w-full flex flex-col rounded-2xl  py-3 px-4',
              'bg-surface-900  border border-surface-200  hover-up-lg',
              index % 2 === 0 ? 'timeline_animate__from_left' : 'timeline_animate__from_right',
            ]}
          >

            <div
              class:list={[
                'flex items-center justify-center gap-2 bg-surface-100 w-min',
                'truncate px-3 py-1 rounded-2xl',
                index % 2 === 0 ? 'self-start' : 'self-end',
              ]}
            >
              <Icon name={p.timeline?.icon ?? 'ri:calendar-line'} class="h-4 w-4 text-console" />
              <span class="text-sm font_console text-accent font-bold">{formatDateRange(p.date, 'en')}</span>
            </div>

            <h3 data-i18n={p.title}
              class:list={[
                'gap-2 font_console text-xl tracking-wider text-console mt-4 mb-4',
                index % 2 === 0 ? 'self-start pl-2' : 'self-end pr-2',
              ]}
            >
              Ecommerce Engine
            </h3>

            <p data-i18n={p.timeline?.summary} data-i18n-join="space"
              class:list={[
                'gap-2 font_console text-base text-content-muted text-justify',
                index % 2 === 0 ? 'self-start pl-2' : 'self-end pr-2',
              ]}
            >
              This is mi own complete project.
            </p>

            <div class:list={[
              'flex gap-2 p-2 mt-2',
              index % 2 === 0 ? 'self-start pl-2' : 'self-end pr-2',
            ]}>
              {p.links.map((link) => (
                <a target={link.newTab ? '_blank' : undefined} href={link.href}
                  class:list={[
                    'flex hover-up-lg items-center justify-center btn_notched btn_notched_surface_900',
                    'h-10 px-3 py-2 gap-2 group',
                  ]}
                >
                  <Icon name={link.icon} class="h-5.5 w-5.5" />
                  <span data-i18n={link.i18n} class="font_console truncate tracking-wide">Link Label</span>
                </a>
              ))}
            </div>

          </div>

          <div class="timeline_cont__icon bg-console-400 h-10 w-10 border border-console-100
            flex items-center justify-center">
            <Icon name={p.timeline?.icon ?? 'ri:calendar-line'} class="h-5.5 w-5.5 text-white" />
          </div>
        </li>
      ))}
    </ul>
  </Section>

  
  <!-- + MILESTONES SECTION  -->
  <Section class:list={['bg-surface-800 p-16', WIDTH_CLASSES.full]}>

    <div class="flex flex-col gap-3 mb-6 timeline_animate__from_left items-center justify-center w-full" data-reveal data-multi-anim>
      <h2 class="font_console text-3xl flex items-center gap-2 tracking-wider" >
        <span class="text-accent">$</span>
        <span class="text-console">cat</span>
        <span data-i18n={I18N.about.milestone.title}>milestones.log</span>
      </h2>
      <span class="font_console text-base text-content-muted tracking-wider" data-i18n={I18N.about.milestone.subtitle}>
        A brief summary of my entire journey—a step-by-step chronicle.
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {milestones.map((p, index) => (
        <div data-reveal data-multi-anim
          class:list={[
            'flex flex-col gap-1 p-3 rounded-xl transition-colors border group',
            'bg-surface-900  border-surface-800',
            'hover:bg-surface-200 hover:border-surface-900 hover-up-lg',
            index % 2 === 0 ? 'timeline_animate__from_left' : 'timeline_animate__from_right',
          ]}
        >
          <div class="flex items-center justify-between gap-2">
            <p class="font_console text-sm text-content-muted group-hover:text-content-main">
              <span class="group-hover:text-console-100"
                data-i18n={I18N.about.milestone.stepSpan}>
                Step:
              </span>
              <span class="group-hover:text-console-100"> {index + 1}</span>
              <span> | {formatDateRange(p.date)}</span>
            </p>
            <span class="w-3 h-3 rounded-full bg-console shadow-[0_0_4px_var(--console-color)]"></span>
          </div>

          <span class="font_console text-base text-console font-semibold truncate" data-i18n={p.title}></span>
          <span class="font_console text-sm text-accent" data-i18n={p.milestone}></span>
          <div class="flex gap-2 mt-2 flex-wrap effect_grayscale">
            {getTechs(p.coreTechs).map((tech) => (
              <Icon
                name={tech.icon}
                class={
                  `self-center place-self-center h-6 w-6
                  ${tech.isOnlyLightTheme ? 'bg-white rounded-2xl p-0.5' : ''}`}
              />
            ))}
          </div>
        </div>
      ))}
    </div>


  </Section>


  <script>
    import { setEventTypewriter } from '@shared/scripts/utils/typewriter';

    async function boot() {
      // this events call init typewriter methods, only need the right selectors
      setEventTypewriter({
        container: '#aboutMain',
        title: '[data-typewriter]',
        elementsToFade: ['[data-fade-1]'],
      });
    }

    document.addEventListener('astro:page-load', boot);
  </script>

</BaseLayout>
