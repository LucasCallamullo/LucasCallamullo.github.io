---
import '@shared/styles/global.css'

import Navbar from '@shared/components/layout/Navbar.astro';
import Footer from '@shared/components/layout/Footer.astro';
import BackToTop from '@shared/components/ui/BackToTop.astro'; 
  
// This is to enable SPA
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  /** Extra classes merged into the <main> element. */
  mainClass?: string;
  /** Max width preset for <main>. Default: 'md' (max-w-6xl). */
  mainWidth?: 'sm' | 'md' | 'lg' | 'full';
}

const {
  title,
  mainClass = '',
  mainWidth = 'md',
} = Astro.props;

export const WIDTH_CLASSES = {
  sm: 'max-w-3xl mx-auto',
  md: 'max-w-6xl mx-auto',
  lg: 'max-w-7xl mx-auto',
  full: 'max-w-none mx-auto',
} as const;

const widthClass = WIDTH_CLASSES[mainWidth];


---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta property="og:locale" content="en_US">
    <meta property="og:locale:alternate" content="es_AR">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>

    <!--  -->
    <link rel="icon" type="image/svg+xml" href="/icons/terminal.svg">
    
    <!-- SEO -->
    <meta
      name="description"
      content="Lucas Callamullo · Software Engineer from Córdoba, Argentina.
        Backend-oriented full-stack developer building production-ready e-commerce engines,
        microservices with JWT authentication and clean REST APIs.
        Skilled in Java/Spring Boot, TypeScript/React, C#/.NET, PostgreSQL, Docker and Nginx."
    >
    <meta name="author" content="Lucas Callamullo">

    <!-- Open Graph (LinkedIn, Facebook, WhatsApp) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Lucas Callamullo · Software Engineer & Systems Engineering Student">
    <meta
      property="og:description"
      content="Backend-oriented full-stack engineer. I design and build e-commerce engines,
        microservices architectures and clean REST APIs across Java, Spring Boot, TypeScript and React.
        Currently 4th year Systems Engineering at UTN."
    >
    <meta property="og:url" content="https://lucascallamullo.github.io">
    <meta property="og:site_name" content="Lucas Callamullo · Portfolio">
    <meta property="og:image" content="https://lucascallamullo.github.io/profile/og-image.jpg">
    <meta property="og:locale" content="es_AR">
    <meta property="og:locale:alternate" content="en_US">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Lucas Callamullo · Software Engineer">
    <meta
      name="twitter:description"
      content="Backend-oriented full-stack engineer. E-commerce engines, microservices and REST APIs.
        Java, Spring Boot, TypeScript, React, .NET, Docker, PostgreSQL, Nginx."
    >
    <meta name="twitter:image" content="https://lucascallamullo.github.io/profile/og-image.jpg">

    <!-- Slot para CSS o meta tags específicos de cada página -->
    <slot name="head" />

    <!-- Enables client-side SPA navigation between pages -->
    <ClientRouter fallback="swap"/>
  </head>


  <body class="min-h-screen">
    <!-- Navbar global persistente -->
    <Navbar 
      transition:persist 
      wFull={WIDTH_CLASSES.full} 
      wSon={WIDTH_CLASSES.md}
    > </Navbar>

    <!-- Banner superior opcional -->
    <slot name="banner-header" />

    <!-- mx-auto py-6 space-y-10 max-w-6xl   -- MAIN DEFAULT CLASS -->
    <main class:list={['', widthClass, mainClass]}>
      <!-- Contenido principal por defecto -->
      <slot />
    </main>

    <!-- Banner inferior / CTA opcional -->
    <slot name="banner-footer" />

    <!-- Footer global -->
    <Footer wFull={WIDTH_CLASSES.full} wSon={WIDTH_CLASSES.md}> </Footer>


    <BackToTop extraClass={WIDTH_CLASSES.lg}> </BackToTop>

    <script>
      import { initTranslations, applyTranslations, } from '@shared/scripts/navbar/translations';

      import { initReveal } from '@shared/scripts/utils/reveal';

      // 1. Initial load: fetch from JSON + apply.
      initTranslations();

      // Reveal-on-scroll: el observer es único y se reutiliza.
      // En cada navegación SPA se observan los [data-reveal] nuevos.
      // Wait 200ms before revealing with anims by observer.
      initReveal({ once: true });

      // 2. After each SPA navigation: simply re-apply.
      let firstLoad = true;

      // FUNCTION TO LOAD EVERY SPA PAGE
      async function boot() {

        //! DONT CHANGES THIS ORDER
        if (firstLoad) {
          firstLoad = false;
          return;       // initTranslations already handled it
        }

        applyTranslations();

        // Reveal-on-scroll: el observer es único y se reutiliza.
        // En cada navegación SPA se observan los [data-reveal] nuevos.
        // Wait 200ms before revealing with anims by observer.
        await new Promise((resolve) => setTimeout(resolve, 200));
        initReveal({ once: true });
      }

      document.addEventListener('astro:page-load', boot);

    </script>
  </body>
</html>  