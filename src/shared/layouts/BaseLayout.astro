---
import '@shared/styles/global.css'
import '@shared/styles/custom.css'


import Navbar from '@components/Navbar.astro';

// This is to enable SPA
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;


/* 
<!-- Default / Light -->
<html lang="en" data-theme="light">

<!-- Dark Theme -->
<html lang="en" data-theme="dark">

<!-- Violet Theme -->
<html lang="en" data-theme="violet">

<!-- Blue Theme -->
<html lang="en" data-theme="blue"></html>

<!-- <meta name="theme-color" content="#000000"> --> 

    <!-- Meta tags útiles para SEO y redes sociales -->
    <meta name="description" content="Lucas Callamullo, Software Engineer from Córdoba, Argentina. 
        I build production-ready e-commerce platforms, microservices with JWT authentication, and clean REST APIs. 
        Skilled in Python/Django, Java/Spring Boot, Node.js/Express, Docker, and PostgreSQL.">
    <meta name="author" content="Lucas Callamullo">

    <!-- Open Graph (LinkedIn, Facebook, WhatsApp) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Lucas Callamullo · Software Engineer & Systems Engineering Student">
    <meta property="og:description" content="Portfolio showcasing e-commerce engines, microservices architectures, 
        and API development. Currently 4th year Systems Engineering at UTN.">

    <meta property="og:url" content="https://lucascallamullo.github.io">
    <meta property="og:site_name" content="Lucas Callamullo · Portfolio">
    <meta property="og:image" content="https://lucascallamullo.github.io/staticfiles/og-image.jpg">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Lucas Callamullo · Software Engineer">
    <meta name="twitter:description" content="Building scalable backend systems. E-commerce, microservices, 
        REST APIs. Python, Java, Node.js, Docker.">

*/

---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="./staticfiles/icon/terminal.svg">

    <!-- Slot para CSS o meta tags específicos de cada página -->
    <slot name="head" />

    <!-- Enables client-side SPA navigation between pages -->
    <ClientRouter fallback="swap"/>
  </head>


  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <!-- Navbar global persistente -->
    <Navbar transition:persist></Navbar>

    <!-- Banner superior opcional -->
    <slot name="banner-header" />

    <main class="mx-auto py-6 space-y-10 max-w-6xl"> 
      <!-- Contenido principal por defecto -->
      <slot />
    </main>

    <!-- Banner inferior / CTA opcional -->
    <slot name="banner-footer" />

    <!-- Footer global 

    
    <script>
      import { resetModals } from '@shared/scripts/utils/modal';

      // Limpia el estado global antes de que Astro cambie de página.
      document.addEventListener('astro:before-swap', resetModals);
    </script>
  -->
    <script>
      import { initTranslations, applyTranslations, } from '@shared/scripts/utils/translations';

      // 1. Carga inicial: fetch del JSON + aplicar.
      initTranslations();

      // 2. Después de cada navegación SPA: solo reaplicar.
      let firstLoad = true;

      document.addEventListener('astro:page-load', () => {
        if (firstLoad) {
          firstLoad = false;
          return; // initTranslations ya se encargó
        }
        applyTranslations();
      });
    </script>
  </body>
</html>  