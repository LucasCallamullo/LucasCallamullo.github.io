---
import { Icon } from 'astro-icon/components';
import { I18N } from '@shared/scripts/utils/i18n_keys';
import { navItems, getSocialLinks, SOCIAL_LINKS } from '@shared/data/links';
import { iban } from 'astro:schema';
import { isRenderTemplateResult } from 'astro/runtime/server/render/astro/render-template.js';

interface Props {
  class?: string;
  classSon?: string;
}

const { 
  class: className = '',
  classSon: classSon = ''
} = Astro.props;

const LINKS_SOCIAL = getSocialLinks(['linkedin', 'github', 'email']);
---

<footer class:list={['bg-surface-900 border-t border-content-muted px-4 sm:px-6 lg:px-20', className]}>

  <div class:list={[
    "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-3 pb-4 pt-10",
    classSon
  ]}>

    <!-- + CONTENEDOR CONSOLA -->
    <div class="border border-content-muted rounded-lg hover:rounded-none w-full mx-auto
      transition-all duration-300 ease-out bg-surface-200
      flex flex-col p-4">

      <h4 class="font_console text-xl">
        <span class="text-accent">$</span>
        <span class="blinking_underscore text-lg">_</span>
        <span class="text-content-muted ms-1.5">cat&nbsp;</span>
        <span class="text-accent tracking-wider font-bold">whoami.txt</span>
      </h4>

      <p class="mt-3.5 font_console text-lg">
        <span class="text-accent font-bold">&gt;</span>
        <span class="blinking_underscore">_</span>
        <span class="text-console font-bold tracking-wider">Lucas Callamullo</span>
      </p>

      <p class="mt-2.5 font_console text-base flex gap-2">
        <span class="text-accent font-bold">&gt;</span>
        <span class="blinking_underscore font-bold">_</span>
        <span class="tracking-wider font-medium text-justify text-content-muted" data-i18n={I18N.footer.resume}>
          Backend Developer building scalable APIs with Python & Java. 
          PostgreSQL, Docker, and cloud deployments.
        </span>
      </p>

      <a class="mt-5 mb-1 w-min flex gap-3 group px-3 py-2 items-center justify-center
        border-console border rounded hover:rounded-none transition-all duration-300 ease-out" 
        data-i18n={I18N.links.cv.href}
        data-altText={I18N.links.cv.altText}
        data-cv="true"
        target="_blank"
        download={SOCIAL_LINKS.cv.altText}
        href={SOCIAL_LINKS.cv.href}>
          <Icon name={SOCIAL_LINKS.cv.icon} class="text-lg text-console group-hover:text-content-main"></Icon>
          <span class="font_console text-base text-console group-hover:text-content-main tracking-wide" 
            data-i18n={I18N.footer.downloadLabel}>
            ./download_cv.sh
          </span>
      </a>
    </div>

    <!-- + CONTENEDOR CONSOLA -->
    <div class="border border-content-muted rounded-lg hover:rounded-none transition-all duration-300 ease-out
      p-4 w-full mx-auto flex flex-col bg-surface-200">

      <h4 class="font_console text-xl">
        <span class="text-accent">$</span>
        <span class="blinking_underscore text-lg">_</span>
        <span class="text-content-muted ms-1.5">ls&nbsp;</span>
        <span class="text-accent font-bold tracking-wider">routes/</span>
      </h4>

      <ul class="mt-3.5 flex flex-col gap-2">
        {navItems.map((item) => (
          <li>
            <a class="flex gap-2 w-min px-2 items-center justify-start group hover-up font_console text-lg" 
              data-nav={item.nav} href={item.href}
            >
              <span class="text-accent font-bold">&gt;</span>
              <span class="tracking-wider group-hover:text-console lowercase truncate" 
                data-i18n={item.i18n}>
                  {item.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
      
    </div>


    <!-- + CONTENEDOR CONSOLA -->
    <div class="border border-content-muted rounded-lg hover:rounded-none transition-all duration-300 ease-out
      p-4 w-full h-full justify-between mx-auto flex flex-col bg-surface-200">

      <div>
        <h4 class="font_console text-xl">
          <span class="text-accent">$</span>
          <span class="blinking_underscore text-lg">_</span>
          <span class="text-content-muted tracking-wider ms-1.5">ssh&nbsp;</span>
          <span class="text-accent font-bold tracking-wider">connect@lucas.dev</span>
        </h4>

        <ul class="mt-3.5 flex flex-col gap-2">
          {Object.entries(LINKS_SOCIAL)
            .map(([key, item]) => (
            <li> 
              <a class="flex w-min px-2 items-center justify-start group hover-up font_console text-lg" 
                href={item.href} target="_blank"
              >
                <Icon name={item.icon} class="group-hover:text-accent me-2 h-5.5 w-5.5"></Icon>
                <span class="text-content-muted group-hover:text-content-main">open&nbsp;</span>
                <span class="group-hover:text-console" data-i18n={item.i18n}>
                  {item.altText}
                </span>
                <Icon name="ri:external-link-fill" class="group-hover:text-accent ms-2 h-5.5 w-5.5"></Icon>
              </a>
            </li>
          ))} 
        </ul>
      </div> 
 
      <p class="border-t border-surface-800 pt-3 flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-brand-green-100 shadow-brand-green-100 animate-pulse"></span>
        <span class="text-content-muted font_console text-base tracking-wide">online · ART (UTC-3)</span>
      </p>
    </div>

    <!-- LAST FOOTER STUFF -->
    <div class="col-span-full border-t border-content-main mt-3 flex items-center justify-between">

      <p class="p-3 flex flex-wrap gap-2 items-center font_console text-lg tracking-wide">
        <span class="text-accent">$</span>
        <span class="text-console">echo</span>
        <Icon name="ri:copyright-line" class="h-4 w-4"></Icon>
        <span class="">2026 Lucas Callamullo · UTN</span>
      </p>

      <p class="p-3 font_console text-lg tracking-wide">
        <span class="" data-i18n={I18N.footer.build}>built with: </span>
        <span class="font-bold text-console"> Astro</span>
        <span class=""> | </span>
        <span class="font-bold text-console">TypeScript</span>
        <span class=""> | </span>
        <span class="font-bold text-console">Tailwind</span>
      </p>
    </div>

  </div>
</footer>