---
import { Icon } from 'astro-icon/components';

import { WIDTH_CLASSES } from '@shared/layouts/BaseLayout.astro';
import Section from '@shared/components/layout/Section.astro';

interface Props {
  /** ID of the modal element (used for anchors and JS lookup). */
  modalId?: string;
  /** ID of the overlay element. */
  overlayId?: string;
  /** ID of the inner scrollable container where content gets injected. */
  dataId?: string;
  /** Extra classes to apply on the modal container. */
  class?: string;
}

const {
  modalId = 'modalProjects',
  overlayId = 'overlayProjects',
  dataId = `${modalId}Data`,
  class: extraClass = '',
} = Astro.props;

const modalClasses = [
  'modal bg-surface-900 place-self-center w-5/6 md:w-3/4 h-4/5',
  WIDTH_CLASSES.md,
  extraClass,
];
---

<Section class:list={['bg-surface-800', WIDTH_CLASSES.full]} paddingY={false} paddingX={false}>

  <!-- MODAL BACKGROUND LIMITED POP UP -->
  <div id={modalId} class:list={[modalClasses, WIDTH_CLASSES.md]}>

    <div class="modal__content max-h-full max-w-full h-full w-full  
      flex flex-col relative min-h-0">

      <button type="button" title="Close Modal"
        class="modal__btn_close p-2 hover:bg-red-500 group absolute right-0 top-0
          rounded-lg bg-surface-200 text-content-main border border-surface-800
          cursor-pointer"
      >
        <Icon name="ri:close-large-line" class="w-4.5 h-4.5 group-hover:text-white" />
      </button>

      <div
        id={dataId}
        class="modal__data w-full flex flex-col gap-2 px-6 md:px-8 py-8 
          flex-1 min-h-0 overflow-y-auto"
      >
      </div>

    </div>

  </div>

  <!-- OVERLAY BACK OF BACKGROUND -->
  <div id={overlayId} class="overlay"></div>
</Section>