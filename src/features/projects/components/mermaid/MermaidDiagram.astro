---
// src/features/projects/components/mermaid/MermaidDiagram.astro
import { Icon } from 'astro-icon/components';

interface Props {
  /** The Mermaid code string (e.g., 'graph TD...' or 'erDiagram...') */
  chart: string;
  /** Unique ID for this diagram (e.g., 'c4_model', 'der') */
  id: string;
  /** Optional title to show above the diagram */
  title?: string;
  /** Optional filename for download. Defaults to 'diagrama' */
  filename?: string;
  className?: string;
}

const { 
  chart, 
  id, 
  title, 
  filename = 'diagrama',
  className = ''
} = Astro.props;

const btnId = `download-btn-${id}`;
const containerId = `mermaid-container-${id}`;
const cleanChart = chart.trim();
---

<div class="w-full flex flex-col gap-3">
  {title && (
    <h4 class="font_console text-lg text-accent font-semibold">{title}</h4>
  )}
  
  <div 
    id={containerId} 
    class:list={[
      // CLAVE: overflow-x-auto permite el scroll. w-full para que ocupe todo.
      "relative rounded-xl border border-surface-200 w-full overflow-auto! overflow-x-visible",
      // CLAVE: justify-start alinea el SVG a la izquierda para que el scroll funcione bien.
      "flex text-start justify-start items-start min-h-50",
      className
    ]}
  >
    <!-- Botón de descarga flotante -->
    <button 
      id={btnId} 
      type="button"
      class:list={[
        "absolute top-2 right-2 z-10 p-2.5 bg-surface-200 border border-surface-200 cursor-pointer",
        "rounded-lg hover:text-accent transition-colors"
      ]}
      title="Download Diagram"
      aria-label="Download Diagram"
      data-filename={filename} 
    >
      <Icon name="ri:download-2-line" class="w-5 h-5" />
    </button>

    <!-- Mermaid Container -->
    <pre class="mermaid text-center w-full p-0! max-w-none!" 
      data-chart={cleanChart} 
      set:html={cleanChart}
    >
    </pre>
  </div>

  <slot></slot>
</div>

