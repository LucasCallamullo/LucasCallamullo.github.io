---
// src/projects/components/ProjectLanguages.astro

type ChartKind = 'donut' | 'bars' | 'pie';

interface LangStat {
  name: string;
  bytes: number;
  pct: number;
}

interface Props {
  langs: LangStat[];
  title?: string;
  data_i18n?: string;
  /** Which chart to render. Default: 'donut'. */
  kind?: ChartKind;
  /** Donut hole size (0–1). Only for 'donut'. Default: 0.6. */
  cutout?: number;
}

const {
  langs,
  title = 'Most Used Languages',
  data_i18n = '',
  kind = 'donut',
  cutout = 0.6,
} = Astro.props;

// ── Paleta fija por lenguaje ───────────────────────────────
const LANG_COLORS: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Java:       '#b07219',
  Python:     '#306998',  // 306998  // 3572A5    // AMRAILOS   // FFD43B    // E5A93A
  'C#':       '#178600',
  CSS:        '#563d7c',
  HTML:       '#e34c26',
  SCSS:       '#c6538c',
  Dockerfile: '#384d54',
  Shell:      '#89e051',
  Vue:        '#41b883',
  Svelte:     '#ff3e00',
  Astro:      '#ff5d01',
  Go:         '#00ADD8',
  Rust:       '#dea584',
  PHP:        '#4F5D95',
  Ruby:       '#701516',
  Kotlin:     '#A97BFF',
  Swift:      '#F05138',
  C:          '#555555',
  'C++':      '#f34b7d',
  Lua:        '#000080',
  Makefile:   '#427819',
  Nginx:      '#009639',
};

const fallbackPalette = ['#7f8c8d', '#95a5a6', '#bdc3c7', '#546e7a', '#8e44ad'];
const colorFor = (name: string, i: number) =>
  LANG_COLORS[name] ?? fallbackPalette[i % fallbackPalette.length];

// ── Geometría del donut / pie ──────────────────────────────
const SIZE = 170;
const STROKE = 22;
const RADIUS = (SIZE - STROKE) / 2;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;

let offset = 0;
const segments = langs.map((l, i) => {
  const length = (l.pct / 100) * CIRCUMFERENCE;
  const seg = {
    name: l.name,
    pct: l.pct,
    color: colorFor(l.name, i),
    dashArray: `${length} ${CIRCUMFERENCE - length}`,
    dashOffset: -offset,
  };
  offset += length;
  return seg;
});

// ── Torta: arcos SVG ───────────────────────────────────────
const pieRadius = SIZE / 2 - 4;
const pieCenter = SIZE / 2;

// Convierte grados a radianes
const toRad = (deg: number) => (deg * Math.PI) / 180;

// Punto en el círculo según ángulo (empezando arriba)
const pointOnCircle = (cx: number, cy: number, r: number, angleDeg: number) => {
  const a = toRad(angleDeg - 90);
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
};

let angleAcc = 0;
const pieSlices = langs.map((l, i) => {
  const startAngle = angleAcc;
  const endAngle = angleAcc + (l.pct / 100) * 360;
  angleAcc = endAngle;

  const start = pointOnCircle(pieCenter, pieCenter, pieRadius, startAngle);
  const end = pointOnCircle(pieCenter, pieCenter, pieRadius, endAngle);
  const largeArc = endAngle - startAngle > 180 ? 1 : 0;

  // Si es una sola porción (100%), evitamos el path degenerado
  const isFull = langs.length === 1 || l.pct >= 99.999;

  const d = isFull
    ? `M ${pieCenter} ${pieCenter - pieRadius}
       A ${pieRadius} ${pieRadius} 0 1 1 ${pieCenter - 0.01} ${pieCenter - pieRadius} Z`
    : `M ${pieCenter} ${pieCenter}
       L ${start.x} ${start.y}
       A ${pieRadius} ${pieRadius} 0 ${largeArc} 1 ${end.x} ${end.y}
       Z`;

  return { name: l.name, pct: l.pct, color: colorFor(l.name, i), d };
});
---

<div class:list={"bg-surface-900 p-4 rounded-2xl gap-6 flex flex-col"}>

  <div class="flex flex-col md:flex-row items-center gap-8">
    <!-- Leyenda (común a todos los modos) -->
    <div class="flex flex-col gap-3 min-w-min">
      <h3 class="text-base font-semibold text-accent" data-i18n={data_i18n}>{title}</h3>
      <ul class="flex flex-col gap-2">
        {langs.map((l, i) => (
          <li class="flex items-center gap-2 text-sm">
            <span
              class="inline-block w-3 h-3 rounded-sm shrink-0"
              style={`background:${colorFor(l.name, i)}`}
            ></span>
            <span class="font_console">{l.name}</span>
            <span class="text-content-muted ml-auto font_console">
              {l.pct.toFixed(2)}%
            </span>
          </li>
        ))}
      </ul>
    </div>

    <!-- ── MODO DONUT ─────────────────────────────────────── -->
    {kind === 'donut' && (
      <svg
        width={SIZE}
        height={SIZE}
        viewBox={`0 0 ${SIZE} ${SIZE}`}
        class="shrink-0"
        role="img"
        aria-label={`Language breakdown: ${langs.map(l => `${l.name} ${l.pct.toFixed(1)}%`).join(', ')}`}
      >
        <circle
          cx={SIZE / 2}
          cy={SIZE / 2}
          r={RADIUS}
          fill="none"
          stroke="var(--surface-800)"
          stroke-width={STROKE}
        />
        {segments.map((s) => (
          <circle
            cx={SIZE / 2}
            cy={SIZE / 2}
            r={RADIUS}
            fill="none"
            stroke={s.color}
            stroke-width={STROKE}
            stroke-dasharray={s.dashArray}
            stroke-dashoffset={s.dashOffset}
            stroke-linecap="butt"
            transform={`rotate(-90 ${SIZE / 2} ${SIZE / 2})`}
          />
        ))}
      </svg>
    )}

    <!-- ── MODO PIE ───────────────────────────────────────── -->
    {kind === 'pie' && (
      <svg
        width={SIZE}
        height={SIZE}
        viewBox={`0 0 ${SIZE} ${SIZE}`}
        class="shrink-0"
        role="img"
        aria-label={`Language breakdown: ${langs.map(l => `${l.name} ${l.pct.toFixed(1)}%`).join(', ')}`}
      >
        {pieSlices.map((s) => (
          <path d={s.d} fill={s.color} stroke="var(--surface-900)" stroke-width="1" />
        ))}
      </svg>
    )}

    <!-- ── MODO BARRAS ────────────────────────────────────── -->
    {kind === 'bars' && (
      <ul class="flex flex-col gap-3 w-full max-w-md">
        {langs.map((l, i) => (
          <li class="flex flex-col gap-1">
            <div class="flex justify-between text-sm font_console">
              <span>{l.name}</span>
              <span class="text-content-muted">{l.pct.toFixed(2)}%</span>
            </div>
            <div class="h-2 rounded bg-surface-800 overflow-hidden">
              <div
                class="h-full rounded transition-[width] duration-700"
                style={`width:${l.pct}%; background:${colorFor(l.name, i)}`}
              />
            </div>
          </li>
        ))}
      </ul>
    )}

  </div>

  <!-- OTHER STACK -->
  <slot> </slot>

</div>